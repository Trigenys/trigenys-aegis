{
  "name": "@trigenys/trigenys-aegis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "operator:token": "npm run build --silent && node dist/src/cli/operator-token.js",
    "demo": "npm run build --silent && node dist/src/cli/demo.js",
    "demo:seed": "npm run build --silent && node dist/src/cli/seed-demo.js",
    "report:close-month": "npm run build --silent && node dist/src/cli/close-month.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
