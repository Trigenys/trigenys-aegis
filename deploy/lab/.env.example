# Copier en .env (ignoré par git) ou laisser ./setup.sh le créer avec des secrets aléatoires.
# Ne jamais committer .env. Les valeurs ci-dessous sont des exemples, pas des secrets.

# --- Labo ---
# Nom DNS ou IP par lequel les agents joignent MeshCentral.
LAB_HOSTNAME=lab.example.invalid
LAB_TIMEZONE=UTC
# Interface d'écoute des consoles web (Wazuh, GLPI). 127.0.0.1 = accès par tunnel SSH uniquement.
CONSOLE_BIND=127.0.0.1

# --- Secrets (setup.sh les remplace par des valeurs aléatoires) ---
# Wazuh API : 8 à 64 caractères avec majuscule, minuscule, chiffre et symbole.
# Éviter « $ » dans toutes les valeurs (interpolation Compose).
WAZUH_INDEXER_PASSWORD=change-me-Indexer1.
WAZUH_DASHBOARD_PASSWORD=change-me-Dashboard1.
WAZUH_API_PASSWORD=change-me-Api1.
GLPI_DB_PASSWORD=change-me-glpi
GLPI_DB_ROOT_PASSWORD=change-me-root

# --- Versions épinglées (changer ici, puis relire les notes de version) ---
WAZUH_VERSION=4.14.10
WAZUH_DOCKER_REF=v4.14.10
WAZUH_CERT_TOOL_VERSION=4.14
WAZUH_CERTS_GENERATOR_VERSION=0.0.5
MESHCENTRAL_VERSION=1.3.1
GLPI_VERSION=12.0.2
MARIADB_VERSION=11.8.9

# --- Ports publiés ---
WAZUH_AGENT_PORT=1514
WAZUH_ENROLL_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_API_PORT=55000
WAZUH_INDEXER_PORT=9200
WAZUH_DASHBOARD_PORT=8443
MESHCENTRAL_HTTPS_PORT=443
MESHCENTRAL_HTTP_PORT=80
GLPI_HTTP_PORT=8080

# --- Limites mémoire (total par défaut : environ 5,8 Go) ---
WAZUH_INDEXER_HEAP=1g
WAZUH_INDEXER_MEM=2g
WAZUH_MANAGER_MEM=1g
WAZUH_DASHBOARD_MEM=1g
MESHCENTRAL_MEM=512m
GLPI_MEM=512m
GLPI_DB_MEM=768m

GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
